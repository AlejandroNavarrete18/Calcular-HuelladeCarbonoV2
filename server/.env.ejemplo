# Puerto en el que escucha la API.
PORT=3001

# Paginas autorizadas a llamar a la API
# Desarrollo local: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# true: el servidor también entrega la interfaz compilada y requiere ejecutar antes: npm run build
# false: la interfaz se sirve aparte: npm run dev en desarrollo.
SERVE_CLIENT=false

# Cantidad de proxies entre el navegador y este servidor 
TRUST_PROXY=


# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=huella_carbono

# Conexiones simultaneas del pool.
DB_CONNECTION_LIMIT=10

# Cada cuántos segundos se vuelve a leer el cuestionario de la base los cambios se ven en ese tiempo.
CUESTIONARIO_CACHE_SECONDS=60

# true: no se envía ningún correo, se guarda una vista previa en server/.dry-run/.
# En ese modo MAIL_SECRET_KEY no es obligatoria
MAIL_DRY_RUN=false

# Llave para cifrar y descifrar las contraseñas de aplicación guardadas en la base
MAIL_SECRET_KEY=

# Nombre que ve la persona como remitente (si la cuenta de correo no tiene uno propio).
MAIL_FROM_NAME=Calculadora de Huella de Carbono

# correo al que llegarian las respuestas de las personas.
MAIL_REPLY_TO=

# Límites de uso (opcionales: si se omiten, se usan estos valores)
# Peticiones a la API por IP en 15 minutos.
LIMIT_API_PER_IP_PER_15MIN=600

# Participaciones guardadas por IP en una hora varias personas de un mismo salón comparten IP.
LIMIT_SUBMISSIONS_PER_IP_PER_HOUR=60

# Correos que puede recibir una misma dirección en una hora.
LIMIT_EMAILS_PER_RECIPIENT_PER_HOUR=3

# El primer superadministrador se crea desde la terminal (ver README): node server/scripts/crear-administrador.js
# Horas que dura una sesión abierta, después hay que volver a iniciar sesión.
# La sesión es de navegador: se cierra al cerrar la pestaña o el navegador
ADMIN_SESSION_HOURS=3
# Minutos sin usar el panel tras los cuales la sesión se cierra sola.
ADMIN_IDLE_MINUTES=15
# Segundos que espera el servidor tras avisar que se cerró la ventana antes de terminar la sesión (cubre recargas y otras pestañas).
ADMIN_CLOSE_GRACE_SECONDS=45
ADMIN_COOKIE_SECURE=true

# Intentos de contraseña fallidos antes de bloquear la cuenta, y minutos que dura el bloqueo.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15

# Intentos fallidos de inicio de sesión por IP en 15 minutos, y exportaciones (Excel, PDF o CSV) por IP en una hora.
LIMIT_ADMIN_LOGIN_PER_IP_PER_15MIN=20
LIMIT_ADMIN_EXPORTS_PER_HOUR=20